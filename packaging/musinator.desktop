[Desktop Entry]
Type=Application
Name=Musinator
GenericName=Music Player
Comment=A modern-looking terminal music player
Exec=musinator %F
Icon=musinator
Terminal=true
Categories=Audio;AudioVideo;Player;ConsoleOnly;
Keywords=music;player;flac;mp3;
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/mp3;audio/mp4;audio/x-m4a;audio/aac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/aiff;audio/x-aiff;audio/x-matroska;
