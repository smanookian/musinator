# Maintainer: Stepan Manookian <jclstefan at yahoo dot de>
pkgname=musinator-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="A modern-looking terminal music player: gapless, ReplayGain, real album art, themes"
arch=('x86_64')
url="https://github.com/smanookian/musinator"
license=('MIT')
depends=('libpipewire' 'opus' 'gcc-libs' 'glibc')
optdepends=('playerctl: control playback from scripts')
provides=('musinator')
conflicts=('musinator')
source_x86_64=("musinator-$pkgver-x86_64-linux.tar.gz::$url/releases/download/v$pkgver/musinator-x86_64-linux.tar.gz")
sha256sums_x86_64=('SKIP')

package() {
  install -Dm755 musinator "$pkgdir/usr/bin/musinator"
  install -Dm644 musinator.desktop "$pkgdir/usr/share/applications/musinator.desktop"
  [ -f musinator.svg ] && install -Dm644 musinator.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/musinator.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
